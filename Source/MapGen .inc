// ---- helpers ------------------------------------------------------------------
static bool MgMapOk( FOMapper* m )
{
    return m->CurProtoMap && m->HexMngr.IsMapLoaded();
}

static void MgReset()
{
    MG.Active = false;
    MapGenPreviewActive = false;
    MG.Map = NULL;
    MG.At.clear();
    MG.TilesBackup.clear();
    MG.Cur = MapGen::Result();
    MG.Drag = -1;
    MG.Pending = false;
}

// panel geometry: bottom edge lines up with the MapGen button, right edge sits left of the button column
static const int MG_PANEL_H = 24 + 24 + MG_NUM * MG_ROW_H + 20 + 18 + 58 + 6;

static void MgGeom( int& px, int& py )
{
    MapGenPlaceButton();
    px = MapGenBtn[ 2 ] - MG_PANEL_W;
    py = MapGenBtn[ 1 ] - 6 - MG_PANEL_H;
    if( px < 4 )
        px = 4;
    if( py < 8 )
        py = 8;
}

static bool MgIn( int l, int t, int r, int b )
{
    return GameOpt.MouseX >= l && GameOpt.MouseX <= r && GameOpt.MouseY >= t && GameOpt.MouseY <= b;
}

// row layout (y offsets inside the panel)
static int MgSeedY() { return 24; }
static int MgSliderY( int i ) { return 24 + 24 + i * MG_ROW_H; }
static int MgCounterY() { return 24 + 24 + MG_NUM * MG_ROW_H; }
static int MgButtonsY() { return MgCounterY() + 20 + 18; }

static void MgTrack( int px, int& l, int& r )
{
    l = px + 92;
    r = px + 176;
}

// ---- drawing ------------------------------------------------------------------
static PointVec MgPts;

static void MgPoint( int idx, int x, int y, uint col )
{
    MgPts[ idx ].PointX = x;
    MgPts[ idx ].PointY = y;
    MgPts[ idx ].PointColor = col;
    MgPts[ idx ].PointOffsX = NULL;
    MgPts[ idx ].PointOffsY = NULL;
}

static void MgFill( int l, int t, int r, int b, uint col )
{
    MgPts.resize( 6 );
    MgPoint( 0, l, t, col ); MgPoint( 1, r, t, col ); MgPoint( 2, l, b, col );
    MgPoint( 3, r, t, col ); MgPoint( 4, r, b, col ); MgPoint( 5, l, b, col );
    SprMngr.DrawPoints( MgPts, PRIMITIVE_TRIANGLELIST );
}

static void MgFrame( int l, int t, int r, int b, uint col )
{
    MgPts.resize( 5 );
    MgPoint( 0, l, t, col ); MgPoint( 1, r, t, col ); MgPoint( 2, r, b, col ); MgPoint( 3, l, b, col ); MgPoint( 4, l, t, col );
    SprMngr.DrawPoints( MgPts, PRIMITIVE_LINESTRIP );
}

static void MgText( int l, int t, int r, int b, const char* s, uint col, bool center )
{
    SprMngr.DrawStr( Rect( l, t, r, b ), s, FT_NOBREAK | FT_CENTERY | ( center ? FT_CENTERX : 0 ), col );
}

static void MgButton( int l, int t, int r, int b, const char* s, bool enabled )
{
