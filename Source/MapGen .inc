// ============================================================================
// Noise
// ============================================================================
// w x h values in [0,1]. Value noise, bilinear + smoothstep, `octaves` layers.
static void FractalNoise( int w, int h, int seed, int octaves, double persistence, std::vector< float >& out )
{
    Rng                   rng( (MgU64) (unsigned) seed );
    std::vector< double > acc( (size_t) w * h, 0.0 );
    double                amp = 1.0, total = 0.0;
    std::vector< int >    ixs( w ), iys( h );
    std::vector< double > fxs( w ), fys( h );
    for( int o = 0; o < octaves; o++ )
    {
        int cells = 4 << o;
        int gs = cells + 2;
        std::vector< double > g( (size_t) gs * gs );
        for( size_t k = 0; k < g.size(); k++ ) g[ k ] = rng.Next();
        for( int k = 0; k < w; k++ )
        {
            double t = (double) cells * k / w;
            int    i = (int) t;
            double fr = t - i;
            ixs[ k ] = i;
            fxs[ k ] = fr * fr * ( 3.0 - 2.0 * fr );
        }
        for( int k = 0; k < h; k++ )
        {
            double t = (double) cells * k / h;
            int    i = (int) t;
            double fr = t - i;
            iys[ k ] = i;
            fys[ k ] = fr * fr * ( 3.0 - 2.0 * fr );
        }
        for( int y = 0; y < h; y++ )
        {
            int    iy = iys[ y ];
            double fy = fys[ y ];
            for( int x = 0; x < w; x++ )
            {
                int    ix = ixs[ x ];
                double fx = fxs[ x ];
                double a = g[ iy * gs + ix ], b = g[ iy * gs + ix + 1 ];
                double c = g[ ( iy + 1 ) * gs + ix ], d = g[ ( iy + 1 ) * gs + ix + 1 ];
                double v = ( a * ( 1 - fx ) + b * fx ) * ( 1 - fy ) + ( c * ( 1 - fx ) + d * fx ) * fy;
                acc[ (size_t) y * w + x ] += v * amp;
            }
        }
        total += amp;
        amp *= persistence;
    }
    double mn = 1e30, mx = -1e30;
    for( size_t k = 0; k < acc.size(); k++ )
    {
        acc[ k ] /= total;
        if( acc[ k ] < mn ) mn = acc[ k ];
        if( acc[ k ] > mx ) mx = acc[ k ];
    }
    out.resize( acc.size() );
    for( size_t k = 0; k < acc.size(); k++ ) out[ k ] = (float) ( ( acc[ k ] - mn ) / ( mx - mn + 1e-9 ) );
}

// ============================================================================
// Playable shape (upright screen rectangle = skewed hex rectangle) and scroll blockers
// ============================================================================
//   x = (u - v) / 2 ,  y = (3u + v) / 4         (inverse of u = y + x/2, v = y - 1.5x)
// A rectangle [u0,u0+A] x [v0,v0+B] fits the array 0<=x<W, 0<=y<H when
//   A + B <= 2W   and   3A + B <= 4H.
// Square n x n  ->  A = B = n  (exactly what MapGen9000.py hard-codes).
void Generator::PlayRect( int width, int height, double& umin, double& umax, double& vmin, double& vmax )
{
    double W = width, H = height, A, B;
    if( W <= H )              { A = W; B = W; }                  // height is not the limit
    else if( 3 * W >= 4 * H ) { A = 2 * H / 3; B = 2 * H; }      // very wide array
    else                      { A = 2 * H - W; B = 3 * W - 2 * H; }   // both limits tight

    // free placement: centre the rectangle inside whatever slack is left
    double pLo = B, pHi = 2 * W - A;                // allowed range of u0 - v0
    double qLo = 0, qHi = 4 * H - 3 * A - B;        // allowed range of 3*u0 + v0
    double p = ( pLo + pHi ) * 0.5, q = ( qLo + qHi ) * 0.5;
    double u0 = ( p + q ) / 4.0, v0 = ( q - 3.0 * p ) / 4.0;

    umin = std::floor( u0 + 0.25 );
    vmin = std::ceil( v0 + 0.25 );
    umax = umin + A - 0.5;
    vmax = vmin + B - 0.5;
}

bool Generator::InsidePlayRect( int x, int y, double umin, double umax, double vmin, double vmax )
{
    double u = y + x / 2.0;
    double v = y - 1.5 * x;
    return u >= umin && u <= umax && v >= vmin && v <= vmax;
}

static const int BLOCK_EVEN[ 4 ][ 2 ] = { { -1, 0 }, { -1, 1 }, { 0, 1 }, { 1, 0 } };
static const int BLOCK_ODD[ 4 ][ 2 ] = { { -1, -1 }, { -1, 0 }, { 0, 1 }, { 1, -1 } };

void Generator::EnsureShape( int w, int h )
{
    if( insW == w && insH == h ) return;
    insW = w; insH = h;
    ins.assign( (size_t) w * h, 0 );
    blockGrid.assign( (size_t) w * h, 0 );
    blockCount = 0;

    double umin, umax, vmin, vmax;
    PlayRect( w, h, umin, umax, vmin, vmax );
    for( int y = 0; y < h; y++ )
        for( int x = 0; x < w; x++ )
            ins[ (size_t) y * w + x ] = InsidePlayRect( x, y, umin, umax, vmin, vmax ) ? 1 : 0;

    // one-hex line along the border
    for( int y = 0; y < h; y++ )
    {
        for( int x = 0; x < w; x++ )
        {
            if( !ins[ (size_t) y * w + x ] ) continue;
            const int( *off )[ 2 ] = ( x % 2 == 0 ) ? BLOCK_EVEN : BLOCK_ODD;
            bool out = false;
            for( int k = 0; k < 4 && !out; k++ )
            {
                int nx = x + off[ k ][ 0 ], ny = y + off[ k ][ 1 ];
                if( nx < 0 || ny < 0 || nx >= w || ny >= h || !ins[ (size_t) ny * w + nx ] ) out = true;
            }
            if( out ) { blockGrid[ (size_t) y * w + x ] = BLOCKER_PID; blockCount++; }
        }
    }
    // shape changed -> everything keyed on the size is stale
    groundW = -1; tileW = -1; noiseW = -1;
}

// ============================================================================
// Ground mask: organic dark patches ("blobs"), like the real maps
// ============================================================================
static void Shift( const std::vector< char >& a, int w, int h, int dx, int dy, std::vector< char >& out )
{
    out.assign( a.size(), 0 );
    for( int y = 0; y < h; y++ )
    {
        int sy = y - dy;
        if( sy < 0 || sy >= h ) continue;
        for( int x = 0; x < w; x++ )
        {
            int sx = x - dx;
            if( sx < 0 || sx >= w ) continue;
            out[ (size_t) y * w + x ] = a[ (size_t) sy * w + sx ];
        }
    }
}

static void Erode( std::vector< char >& a, int w, int h )
{
    std::vector< char > r = a, t;
    for( int dx = -1; dx <= 1; dx++ )
        for( int dy = -1; dy <= 1; dy++ )
        {
            Shift( a, w, h, dx, dy, t );
            for( size_t k = 0; k < r.size(); k++ ) r[ k ] = r[ k ] && t[ k ];
        }
    a = r;
}

static void Dilate( std::vector< char >& a, int w, int h )
{
    std::vector< char > r = a, t;
    for( int dx = -1; dx <= 1; dx++ )
        for( int dy = -1; dy <= 1; dy++ )
        {
            Shift( a, w, h, dx, dy, t );
            for( size_t k = 0; k < r.size(); k++ ) r[ k ] = r[ k ] || t[ k ];
        }
    a = r;
}

static bool BySizeDesc( int a, int b ) { return a > b; }

// mw x mh, 1 = blob cell. Blobs are kept `gap` tiles apart.
static void BlobMask( int mw, int mh, int seed, double share, std::vector< char >& result )
{
    const double median = 36, sigma = 0.95;
    const int    min_size = 7, max_size = 330;
    // Spacing between blobs. Wide gaps look best, but they cap coverage near 40%; for bigger
    // targets let blobs sit closer / touch so the slider can still reach its value.
    const int    gap = share > 0.40 ? 0 : ( share > 0.32 ? 1 : 2 );

    Rng                 rng( (MgU64) (unsigned) seed + 99 );
    double              target = share * mw * mh * 1.1;
    std::vector< char > occ( (size_t) mw * mh, 0 ), block( (size_t) mw * mh, 0 );
    int                 total = 0;
    std::vector< int >  sizes;
    long                sum = 0;
    while( sum < target * 1.3 && sizes.size() < 400 )
    {
        double v = std::exp( std::log( median ) + sigma * rng.Normal() );
        int    s = (int) ( v < min_size ? min_size : ( v > max_size ? max_size : v ) );
        sizes.push_back( s );
        sum += s;
    }
    std::sort( sizes.begin(), sizes.end(), BySizeDesc );

    for( size_t si = 0; si < sizes.size(); si++ )
    {
        if( total >= target ) break;
        int A = sizes[ si ];
        for( int attempt = 0; attempt < 60; attempt++ )
        {
            double cx = rng.Uniform( 0, mw ), cy = rng.Uniform( 0, mh );
            double aspect = rng.Uniform( 1.0, 2.2 );
            double th = rng.Uniform( 0, PI_ );
            double b = std::sqrt( A / ( PI_ * aspect ) );
            double a = aspect * b;
            double ph0 = rng.Uniform( 0, 2 * PI_ ), ph1 = rng.Uniform( 0, 2 * PI_ ), ph2 = rng.Uniform( 0, 2 * PI_ );
            int    R = (int) ( a * 1.7 ) + 3;
            int    x0 = std::max( 0, (int) cx - R ), x1 = std::min( mw, (int) cx + R + 1 );
            int    y0 = std::max( 0, (int) cy - R ), y1 = std::min( mh, (int) cy + R + 1 );
            int    ww = x1 - x0, wh = y1 - y0;
            if( ww <= 0 || wh <= 0 ) continue;

            std::vector< char > blob( (size_t) ww * wh, 0 );
            int                 cnt = 0;
            bool                hit = false;
            double              ct = std::cos( th ), st = std::sin( th );
            for( int yy = y0; yy < y1; yy++ )
                for( int xx = x0; xx < x1; xx++ )
                {
                    double dx = xx - cx, dy = yy - cy;
                    double u = ( dx * ct + dy * st ) / a;
                    double v = ( -dx * st + dy * ct ) / b;
                    double phi = std::atan2( v, u );
                    double lim = 1 + 0.25 * std::sin( 2 * phi + ph0 ) + 0.2 * std::sin( 3 * phi + ph1 ) + 0.12 * std::sin( 5 * phi + ph2 );
                    if( std::sqrt( u * u + v * v ) <= lim )
                    {
                        blob[ (size_t) ( yy - y0 ) * ww + ( xx - x0 ) ] = 1;
                        cnt++;
                        if( block[ (size_t) yy * mw + xx ] ) hit = true;
                    }
                }
            if( cnt < min_size || hit ) continue;

            for( int yy = y0; yy < y1; yy++ )
                for( int xx = x0; xx < x1; xx++ )
                    if( blob[ (size_t) ( yy - y0 ) * ww + ( xx - x0 ) ] ) occ[ (size_t) yy * mw + xx ] = 1;
            total += cnt;

            int X0 = std::max( 0, x0 - gap ), X1 = std::min( mw, x1 + gap );
            int Y0 = std::max( 0, y0 - gap ), Y1 = std::min( mh, y1 + gap );
            int rw = X1 - X0, rh = Y1 - Y0;
            std::vector< char > reg( (size_t) rw * rh );
            for( int yy = 0; yy < rh; yy++ )
                for( int xx = 0; xx < rw; xx++ ) reg[ (size_t) yy * rw + xx ] = occ[ (size_t) ( Y0 + yy ) * mw + ( X0 + xx ) ];
            for( int g = 0; g < gap; g++ ) Dilate( reg, rw, rh );
            for( int yy = 0; yy < rh; yy++ )
                for( int xx = 0; xx < rw; xx++ )
                    if( reg[ (size_t) yy * rw + xx ] ) block[ (size_t) ( Y0 + yy ) * mw + ( X0 + xx ) ] = 1;
            break;
        }
    }
    Erode( occ, mw, mh );          // drop 1-tile spikes
    Dilate( occ, mw, mh );
    result = occ;
}

// mixKey = tileMix * 10, clamped 0..1000 (0 = all dark, 1000 = all light)
void Generator::EnsureGround( int w, int h, int seed, int mixKey )
{
    if( groundW == w && groundH == h && groundSeed == seed && groundMix == mixKey ) return;
    groundW = w; groundH = h; groundSeed = seed; groundMix = mixKey;
    gmw = ( w + 1 ) / 2;
    gmh = ( h + 1 ) / 2;
    if( mixKey <= 0 || mixKey >= 1000 )
    {
        blobs.clear();
        return;
    }
    // The blob packer cannot cover much more than ~45% of the map (spacing rule), so a plain
    // "dark blobs on light ground" slider is dead below ~50. Below 50 we place LIGHT islands on a
    // dark background instead, which makes the slider track the real light/dark share linearly.
    double density = mixKey / 1000.0;
    groundInvert = ( mixKey < 500 );
    BlobMask( gmw, gmh, seed, groundInvert ? density : 1.0 - density, blobs );
}

bool Generator::PatchAtHex( int x, int y, int mixKey ) const
{
    if( mixKey <= 0 ) return true;
    if( mixKey >= 1000 ) return false;
    bool blob = blobs[ (size_t) ( y >> 1 ) * gmw + ( x >> 1 ) ] != 0;
    return groundInvert ? !blob : blob;       // true = dark / rough patch
}

// ============================================================================
// Tile solver: constraint propagation + weighted pick + local repair
// ============================================================================
namespace
{
struct HeapItem
{
    int    cnt;
    double r;
    int    idx;
    bool operator<( const HeapItem& o ) const    // priority_queue is a max-heap -> invert
    {
        if( cnt != o.cnt ) return cnt > o.cnt;
        return r > o.r;
    }
};

struct Solver
{
    int                         mw, mh;
    const std::vector< char >&  valid;
    std::vector< MgU64 >        dom;
    std::vector< MgU64 >        init;
    std::vector< signed char >  res;
    std::map< MgU64, MgU64 >    allowedCache[ 8 ];
    Rng                         rng;
    std::priority_queue< HeapItem > heap;

    Solver( int mw_, int mh_, const std::vector< char >& valid_, MgU64 seed ): mw( mw_ ), mh( mh_ ), valid( valid_ ), rng( seed ) {}

    bool Has( int cx, int cy ) const { return cx >= 0 && cy >= 0 && cx < mw && cy < mh && valid[ (size_t) cy * mw + cx ]; }

    MgU64 Allowed( int d, MgU64 D )
    {
        std::map< MgU64, MgU64 >::iterator it = allowedCache[ d ].find( D );
        if( it != allowedCache[ d ].end() ) return it->second;
        MgU64 r = 0, mm = D;
        while( mm )
        {
            MgU64 b = mm & ( ~mm + 1 );
            int   bit = 0;
            while( !( ( b >> bit ) & 1 ) ) bit++;
            r |= MG_TILE_ADJ[ d ][ bit ];
            mm ^= b;
        }
        allowedCache[ d ][ D ] = r;
        return r;
    }

    void Push( int c )
    {
        HeapItem h;
        h.cnt = PopCount( dom[ c ] );
        h.r = rng.Next();
        h.idx = c;
        heap.push( h );
    }

    void Prop( std::vector< int >& stack )
    {
        while( !stack.empty() )
        {
            int c = stack.back();
            stack.pop_back();
            int   cx = c % mw, cy = c / mw;
            MgU64 D = dom[ c ];
            for( int d = 0; d < 8; d++ )
            {
                int nx = cx + TILE_DX[ d ], ny = cy + TILE_DY[ d ];
                if( !Has( nx, ny ) ) continue;
                int   nb = ny * mw + nx;
                MgU64 nd = dom[ nb ] & Allowed( d, D );
                if( nd != dom[ nb ] && nd )          // dead end: skip, repaired later
                {
                    dom[ nb ] = nd;
                    stack.push_back( nb );
                    Push( nb );
                }
            }
        }
    }

    void Cost( int c, int t, int& broken, double& art ) const
    {
        broken = 0;
        art = 0.0;
        int cx = c % mw, cy = c / mw;
        for( int d = 0; d < 8; d++ )
        {
            int nx = cx + TILE_DX[ d ], ny = cy + TILE_DY[ d ];
            if( !Has( nx, ny ) ) continue;
            int o = res[ (size_t) ny * mw + nx ];
            if( o < 0 ) continue;
            if( !( ( MG_TILE_ADJ[ d ][ t ] >> o ) & 1 ) ) broken++;
            if( d < 4 ) art += MG_ART_ERR[ d ][ t ][ o ];
        }
    }

    void Run()
    {
        const int N = mw * mh;
        dom = init;
        res.assign( (size_t) N, -1 );

        for( int c = 0; c < N; c++ )
        {
            if( !valid[ c ] ) continue;
            std::vector< int > st( 1, c );
            Prop( st );
        }
        for( int c = 0; c < N; c++ )
            if( valid[ c ] ) Push( c );

        while( !heap.empty() )
        {
            HeapItem h = heap.top();
            heap.pop();
            int c = h.idx;
            if( res[ c ] >= 0 ) continue;
            MgU64 D = dom[ c ];
            if( PopCount( D ) != h.cnt ) { Push( c ); continue; }      // stale entry
            if( h.cnt > 1 )
            {
                int    opts[ 64 ], no = 0;
                double w[ 64 ], sum = 0;
                for( int t = 0; t < MG_TILE_COUNT; t++ )
                    if( ( D >> t ) & 1 )
                    {
                        int    br;
                        double art;
                        Cost( c, t, br, art );
                        opts[ no ] = t;
                        w[ no ] = MG_TILE_WEIGHTS[ t ] * std::exp( -art / SEAM_SIGMA );
                        sum += w[ no ];
                        no++;
                    }
                double pick = rng.Next() * sum;
                int    chosen = opts[ no - 1 ];
                for( int k = 0; k < no; k++ )
                {
                    pick -= w[ k ];
                    if( pick < 0 ) { chosen = opts[ k ]; break; }
                }
                dom[ c ] = 1ULL << chosen;
            }
            int t = 0;
            while( !( ( dom[ c ] >> t ) & 1 ) ) t++;
            res[ c ] = (signed char) t;
            std::vector< int > st( 1, c );
            Prop( st );
        }

        // local repair: fix broken rules first, then visible seams
        for( int sweep = 0; sweep < 40; sweep++ )
        {
            std::vector< int > bad;
            for( int c = 0; c < N; c++ )
            {
                if( !valid[ c ] || res[ c ] < 0 ) continue;
                int    br;
                double art;
                Cost( c, res[ c ], br, art );
                if( br || art > SEAM_HARD * 2 ) bad.push_back( c );
            }
            if( bad.empty() ) break;
            for( size_t i = bad.size(); i > 1; i-- ) std::swap( bad[ i - 1 ], bad[ rng.Below( (int) i ) ] );   // shuffle
            for( size_t i = 0; i < bad.size(); i++ )
            {
                int    c = bad[ i ];
                int    br;
                double art;
                Cost( c, res[ c ], br, art );
                double curv = br * 60 + art;
                double bestV = 1e30, bestR = 2;
                int    bestT = -1;
                for( int t = 0; t < MG_TILE_COUNT; t++ )
                {
                    if( !( ( init[ c ] >> t ) & 1 ) ) continue;
                    int    b2;
                    double a2;
                    Cost( c, t, b2, a2 );
                    double v = b2 * 60 + a2, r = rng.Next();
                    if( v < bestV || ( v == bestV && r < bestR ) ) { bestV = v; bestR = r; bestT = t; }
                }
                if( bestT >= 0 && bestV < curv ) res[ c ] = (signed char) bestT;
            }
        }
    }
};

// remove patch pieces smaller than minSize (8-connected) so no lonely edge tiles appear
void DropSmall( int mw, int mh, std::vector< char >& patch, int minSize )
{
    std::vector< char > seen( patch.size(), 0 );
    for( int c = 0; c < mw * mh; c++ )
    {
        if( !patch[ c ] || seen[ c ] ) continue;
        std::vector< int > comp, st( 1, c );
        seen[ c ] = 1;
        while( !st.empty() )
        {
            int p = st.back();
            st.pop_back();
            comp.push_back( p );
            int px = p % mw, py = p / mw;
            for( int dx = -1; dx <= 1; dx++ )
                for( int dy = -1; dy <= 1; dy++ )
                {
                    int qx = px + dx, qy = py + dy;
                    if( qx < 0 || qy < 0 || qx >= mw || qy >= mh ) continue;
                    int q = qy * mw + qx;
                    if( patch[ q ] && !seen[ q ] ) { seen[ q ] = 1; st.push_back( q ); }
                }
        }
        if( (int) comp.size() < minSize )
            for( size_t i = 0; i < comp.size(); i++ ) patch[ comp[ i ] ] = 0;
    }
}
}   // namespace

void Generator::EnsureTiles( int w, int h, int seed, int mixKey, Result& out )
{
    if( tileW == w && tileH == h && tileSeed == seed && tileMixKey == mixKey )
    {
        out.tilesRecomputed = false;
        return;
    }
    tileW = w; tileH = h; tileSeed = seed; tileMixKey = mixKey;
    out.tilesRecomputed = true;

    int                 mw = ( w + 1 ) / 2, mh = ( h + 1 ) / 2;
    std::vector< char > valid( (size_t) mw * mh, 0 ), patch( (size_t) mw * mh, 0 );
    for( int cy = 0; cy < mh; cy++ )
        for( int cx = 0; cx < mw; cx++ )
        {
            int hx = cx * 2, hy = cy * 2;
            if( hx >= w || hy >= h || !ins[ (size_t) hy * w + hx ] ) continue;
            valid[ (size_t) cy * mw + cx ] = 1;
            patch[ (size_t) cy * mw + cx ] = PatchAtHex( hx, hy, mixKey ) ? 1 : 0;
        }
    DropSmall( mw, mh, patch, 6 );

    MgU64 bulk = 0;
    for( int t = 0; t < MG_TILE_COUNT; t++ )
        if( MG_TILE_NAMES[ t ][ 0 ] == '5' ) bulk |= 1ULL << t;       // edg5xxx = main ground
    MgU64 all = ( 1ULL << MG_TILE_COUNT ) - 1;
    MgU64 patchMask = all & ~bulk;

    Solver sv( mw, mh, valid, (MgU64) (unsigned) seed * 7919ULL + 1ULL );
    sv.init.assign( (size_t) mw * mh, 0 );
    for( int c = 0; c < mw * mh; c++ )
        if( valid[ c ] ) sv.init[ c ] = patch[ c ] ? patchMask : bulk;
    sv.Run();

    tileCache.assign( (size_t) mw * mh, 255 );
    for( int c = 0; c < mw * mh; c++ )
        if( valid[ c ] && sv.res[ c ] >= 0 ) tileCache[ c ] = (unsigned char) sv.res[ c ];
}

// ============================================================================
// Noise cache
// ============================================================================
void Generator::EnsureNoise( int w, int h, int seed )
{
    if( noiseW == w && noiseH == h && noiseSeed == seed ) return;
    noiseW = w; noiseH = h; noiseSeed = seed;
    FractalNoise( w, h, seed, 3, 0.30, noiseV );                                   // biome field
    for( int c = 0; c < CAT_COUNT; c++ )
        FractalNoise( w, h, seed + 7 + 101 * c, 3, 0.50, clump[ c ] );             // per-category group field
}

// ============================================================================
// Objects
// ============================================================================
// Biome rules (fixed): which noise range a category likes.
static bool Gate( int cat, double v )
{
    switch( cat )
    {
    case CAT_TREES:     return v >= 0.40;
    case CAT_DRY_TREES: return v < 0.40;
    case CAT_ROCKS:     return true;
    case CAT_CACTUSES:  return v < 0.75;
    case CAT_CORN:      return v >= 0.20 && v <= 0.75;
    case CAT_MISC:      return true;
    case CAT_GRASS:     return v <= 0.75;
    }
    return true;
}

namespace
{
struct Cand
{
    float score;
    int   idx;
    int   cat;
};
bool CandLess( const Cand& a, const Cand& b ) { return a.score < b.score; }
}

const unsigned short* Generator::Protos( int category, int& count )
{
    switch( category )
    {
    case CAT_TREES:     count = COUNT_OF( P_TREES );    return P_TREES;
    case CAT_DRY_TREES: count = COUNT_OF( P_DRY );      return P_DRY;
    case CAT_ROCKS:     count = COUNT_OF( P_ROCKS );    return P_ROCKS;
    case CAT_CACTUSES:  count = COUNT_OF( P_CACTUSES ); return P_CACTUSES;
    case CAT_CORN:      count = COUNT_OF( P_CORN );     return P_CORN;
    case CAT_MISC:      count = COUNT_OF( P_MISC );     return P_MISC;
    case CAT_GRASS:     count = COUNT_OF( P_GRASS );    return P_GRASS;
    }
    count = 0;
    return 0;
}

unsigned short Generator::BlockerProto() { return BLOCKER_PID; }
int            Generator::TileCount() { return MG_TILE_COUNT; }
const char*    Generator::TileName( int index )
{
    static std::string names[ 64 ];
    if( index < 0 || index >= MG_TILE_COUNT ) return "";
    if( names[ index ].empty() ) names[ index ] = std::string( "art\\tiles\\edg" ) + MG_TILE_NAMES[ index ] + ".frm";
    return names[ index ].c_str();
}

Generator::Generator()
{
    insW = -1; insH = -1; blockCount = 0;
    groundW = -1; groundH = -1; groundSeed = 0; groundMix = -1; groundInvert = false; gmw = 0; gmh = 0;
    tileW = -1; tileH = -1; tileSeed = 0; tileMixKey = -1;
    noiseW = -1; noiseH = -1; noiseSeed = 0;
}

void Generator::Generate( int w, int h, const Params& p, Result& out, const std::vector< char >* occupied )
{
    if( w < 10 ) w = 10;
    if( h < 10 ) h = 10;
    int mw = ( w + 1 ) / 2, mh = ( h + 1 ) / 2;

    int mixKey = (int) ( p.tileMix * 10.0f + 0.5f );
    if( mixKey < 0 ) mixKey = 0;
    if( mixKey > 1000 ) mixKey = 1000;

    EnsureShape( w, h );
    EnsureGround( w, h, p.seed, mixKey );
    EnsureTiles( w, h, p.seed, mixKey, out );
    EnsureNoise( w, h, p.seed );

    bool recomputed = out.tilesRecomputed;
    out.width = w;
    out.height = h;
    out.tileCols = mw;
    out.tileRows = mh;
    out.tiles = tileCache;
    out.tilesRecomputed = recomputed;
    const bool useBlk = p.scrollBlockers;
    if( useBlk ) out.grid = blockGrid;
    else         out.grid.assign( (size_t) w * h, 0 );
    out.blockers = useBlk ? blockCount : 0;
    for( int c = 0; c < CAT_COUNT; c++ ) out.counts[ c ] = 0;

    const bool haveOcc = occupied && occupied->size() == (size_t) w * h;

    // ---- candidates: every category is an independent layer ----
    double              ramp = 0.01 + 0.49 * Clamp01( p.edgeBlend / 100.0 );     // ramp half-width
    std::vector< char > blocked( (size_t) w * h, 0 );      // hexes no object may use
    for( size_t i = 0; i < blocked.size(); i++ )
        blocked[ i ] = ( !ins[ i ] || ( useBlk && blockGrid[ i ] ) || ( haveOcc && ( *occupied )[ i ] ) ) ? 1 : 0;
    std::vector< Cand > cands;

    for( int cat = 0; cat < CAT_COUNT; cat++ )
    {
        double amount = p.amount[ cat ] / 100.0;
        if( amount <= 0.0 ) continue;
        if( cat >= CAT_CUSTOM1 && cat <= CAT_CUSTOM3 && !p.customPid[ cat - CAT_CUSTOM1 ] ) continue;   // row has no asset
        const std::vector< float >& cl = clump[ cat ];

        // pass 1: mean eligibility, so the slider means "% of free playable hexes"
        double sumGw = 0;
        long   cnt = 0;
        for( size_t i = 0; i < blocked.size(); i++ )
        {
            if( blocked[ i ] ) continue;
            cnt++;
            if( Gate( cat, noiseV[ i ] ) ) sumGw += SmoothStep( 0.5 - ramp, 0.5 + ramp, cl[ i ] );
        }
        if( cnt == 0 || sumGw <= 0 ) continue;
        double scale = amount * (double) cnt / sumGw;

        // pass 2: candidates
        for( int y = 0; y < h; y++ )
            for( int x = 0; x < w; x++ )
            {
                size_t i = (size_t) y * w + x;
                if( blocked[ i ] ) continue;
                if( !Gate( cat, noiseV[ i ] ) ) continue;
                double prob = scale * SmoothStep( 0.5 - ramp, 0.5 + ramp, cl[ i ] );
                if( cat == CAT_GRASS && PatchAtHex( x, y, mixKey ) ) prob *= 1.5;    // denser on rough ground
                if( prob > 1.0 ) prob = 1.0;
                double r = HashCell( p.seed, x, y, cat );
                if( r < prob )
                {
                    Cand cd;
                    cd.score = (float) ( r / prob );
                    cd.idx = (int) i;
                    cd.cat = cat;
                    cands.push_back( cd );
                    blocked[ i ] = 1;                 // claimed: lower-priority categories skip it
                }
            }
    }

    // ---- cap: thin evenly (keeps category proportions and spread) ----
    out.candidates = (int) cands.size();
    int cap = p.maxObjects < 0 ? 0 : p.maxObjects;
    out.capped = (int) cands.size() > cap;
    if( out.capped )
    {
        std::nth_element( cands.begin(), cands.begin() + cap, cands.end(), CandLess );
        cands.resize( cap );
    }

    // ---- write ----
    for( size_t k = 0; k < cands.size(); k++ )
    {
        const Cand&           cd = cands[ k ];
        int                   count;
        const unsigned short* list = Protos( cd.cat, count );
        int                   x = cd.idx % w, y = cd.idx / w;
        if( cd.cat >= CAT_CUSTOM1 && cd.cat <= CAT_CUSTOM3 )
            out.grid[ cd.idx ] = p.customPid[ cd.cat - CAT_CUSTOM1 ];
        else
        {
            int pick = (int) ( HashCell( p.seed, x, y, 100 + cd.cat ) * count );
            if( pick >= count ) pick = count - 1;
            out.grid[ cd.idx ] = list[ pick ];
        }
        out.counts[ cd.cat ]++;
    }
    out.placed = (int) cands.size();
}

// ============================================================================
// Diffs
// ============================================================================
void DiffObjects( const Result& before, const Result& after, std::vector< ObjChange >& out )
{
    out.clear();
    int w = after.width, h = after.height;
    bool same = ( before.width == w && before.height == h && before.grid.size() == after.grid.size() );
    for( int i = 0; i < w * h; i++ )
    {
        unsigned short a = same ? before.grid[ i ] : 0, b = after.grid[ i ];
        if( a == b ) continue;
        ObjChange c;
        c.x = (unsigned short) ( i % w ); c.y = (unsigned short) ( i / w );
        if( a ) { c.pid = a; c.add = false; out.push_back( c ); }
        if( b ) { c.pid = b; c.add = true; out.push_back( c ); }
    }
}

void DiffTiles( const Result& before, const Result& after, std::vector< TileChange >& out )
{
    out.clear();
    int  mw = after.tileCols, mh = after.tileRows;
    bool same = ( before.tileCols == mw && before.tileRows == mh && before.tiles.size() == after.tiles.size() );
    for( int i = 0; i < mw * mh; i++ )
    {
        unsigned char a = same ? before.tiles[ i ] : 255, b = after.tiles[ i ];
        if( a == b ) continue;
        TileChange c;
        c.hx = (unsigned short) ( ( i % mw ) * 2 );
        c.hy = (unsigned short) ( ( i / mw ) * 2 );
        c.tile = ( b == 255 ) ? -1 : (int) b;
        out.push_back( c );
    }
}
