    { "C2",         &MG.P.amount[ MapGen::CAT_CUSTOM2 ],        0.0f,   30.0f,    0.1f,  false, 1, 2.0f, 1 },
    { "C3",         &MG.P.amount[ MapGen::CAT_CUSTOM3 ],        0.0f,   30.0f,    0.1f,  false, 1, 2.0f, 2 },
    { "Limit",      &MG.Limit,                                  100.0f, 15000.0f, 50.0f, false, 0, 2.0f, -1 },
};

static bool MgIsAsset( const MgControl& c )          // asset sliders (not tile mix / blend / limit)
{
    return c.Value != &MG.P.tileMix && c.Value != &MG.P.edgeBlend && c.Value != &MG.Limit;
}

static float MgQuant( const MgControl& c, float v )
{
    v = c.Min + (float) (int) ( ( v - c.Min ) / c.Step + 0.5f ) * c.Step;
    return v < c.Min ? c.Min : ( v > c.Max ? c.Max : v );
}

// slider position 0..1 <-> value
static float MgToT( const MgControl& c, float v )
{
    float n = ( v - c.Min ) / ( c.Max - c.Min );
    n = n < 0.0f ? 0.0f : ( n > 1.0f ? 1.0f : n );
    return c.Power == 1.0f ? n : (float) pow( (double) n, 1.0 / (double) c.Power );
}
static float MgFromT( const MgControl& c, float t )
{
    t = t < 0.0f ? 0.0f : ( t > 1.0f ? 1.0f : t );
    return MgQuant( c, c.Min + ( c.Max - c.Min ) * ( c.Power == 1.0f ? t : (float) pow( (double) t, (double) c.Power ) ) );
}

