// ---------------------------------------------------------------- Mapper panel
// ============================================================================
// MapGen panel   (#include this file into Mapper.cpp right after the minimap block)
//
//  * A "MapGen" button under Undo / Redo toggles a floating control panel.
//  * Opening the panel runs the generator on the CURRENT map. Tiles and objects are placed
//    into the real map, so the normal Mapper screen (and the minimap) is the live preview.
//  * Asset sliders update the map immediately: only the objects that really changed are
//    added / removed. Seed and Tile mix re-solve the tiles when the mouse is released.
//  * The preview is not an undo step. Closing the panel (or Apply) keeps the result as ONE
//    undo step. Cancel puts the map back exactly as it was.
//  * Objects already on the map are never overwritten (their hexes are skipped), and the
//    scroll blockers are only generated if the map has none.
//
//  Needs: MapGen.h / MapGen.cpp / MapGenTables.h in the project.
// ============================================================================

#define MG_PANEL_W         ( 236 )
#define MG_ROW_H           ( 22 )
#define MG_LIVE_LIMIT      ( 1200 )     // bigger object change than this -> rebuild the hex map once instead of live add/remove
#define MG_THROTTLE_MS     ( 40 )       // while dragging an asset slider

struct MgControl
{
    const char* Label;
    float*      Value;
    float       Min, Max, Step;
    bool        TileStage;      // changing it re-solves the tiles (applied on mouse release)
    int         Decimals;
    float       Power;          // slider curve: value = Min + (Max-Min) * t^Power  (2 = fine control at the low end)
    int         Custom;         // 0..2 = custom asset row (click the name to set the selected asset), -1 = normal
};

struct MgState
{
    bool                      Visible;
    bool                      Active;       // preview tiles / objects are in the map right now
    ProtoMap*                 Map;
    MapGen::Generator         Gen;
    MapGen::Params            P;
    float                     Limit;        // slider mirror of P.maxObjects
    MapGen::Result            Cur;          // what is currently placed in the map
    MapGen::Result            Next;
    std::vector< MapObject* > At;           // generated object per hex (w*h), NULL = none
    ProtoMap::TileVecVec      TilesBackup;  // tiles before the first preview (for Cancel)
    std::vector< uint >       TileHash;     // name hash per tile table index
    bool                      Pending;      // regenerate on the next frame
    int                       Drag;         // control being dragged, -1 = none
    uint                      LastRun;
    bool                      WarnedProto;
    bool                      Blockers;     // generate scroll blockers around the playable area
    bool                      Cleared;      // Clear was pressed: no assets until seed / Rnd / an asset slider is touched (slider values stay)
    std::string               Status;

    MgState(): Visible( false ), Active( false ), Map( NULL ), Limit( 5000.0f ), Pending( false ), Drag( -1 ), LastRun( 0 ), WarnedProto( false ), Blockers( true ), Cleared( false ) {}
};
