static void MapGenDraw()
{
    FOMapper* m = FOMapper::Self;
    if( !m->IntVisible )
        return;
    MapGenButtonDraw();
    if( !MG.Visible )
        return;

    int px, py;
    MgGeom( px, py );
    const int W = MG_PANEL_W;

    MgFill( px, py, px + W, py + MG_PANEL_H, RA_ARGB( 235, 22, 17, 11 ) );
    MgFrame( px, py, px + W, py + MG_PANEL_H, RA_ARGB( 255, 140, 110, 50 ) );
    MgText( px + 8, py, px + W - 8, py + 24, "MapGen", COLOR_TEXT_WHITE, false );

    // seed row
    {
        const int y = py + MgSeedY();
        char      buf[ 64 ];
        MgText( px + 8, y, px + 50, y + MG_ROW_H, "Seed", COLOR_TEXT_WHITE, false );
        MgButton( px + 56, y + 2, px + 76, y + MG_ROW_H - 2, "<", true );
        sprintf( buf, "%d", MG.P.seed );
        MgText( px + 80, y, px + 150, y + MG_ROW_H, buf, COLOR_TEXT_WHITE, true );
        MgButton( px + 154, y + 2, px + 174, y + MG_ROW_H - 2, ">", true );
        MgButton( px + 180, y + 2, px + 228, y + MG_ROW_H - 2, "Rnd", true );
    }

    // sliders
    for( int i = 0; i < MG_NUM; i++ )
    {
        const MgControl& c = MgCtl[ i ];
        const int        y = py + MgSliderY( i );
        int              tl, tr;
        MgTrack( px, tl, tr );
        const int  cy = y + MG_ROW_H / 2;
        const bool hot = ( MG.Drag == i ) || MgIn( px, y, px + W, y + MG_ROW_H - 1 );

        if( c.Custom >= 0 )
        {
            const ushort pid = MG.P.customPid[ c.Custom ];
            char         lb[ 24 ];
            if( pid )
                sprintf( lb, "C%d #%d", c.Custom + 1, (int) pid );
            else
                sprintf( lb, "C%d [set]", c.Custom + 1 );
            const bool lhot = MgIn( px + 8, y, px + 90, y + MG_ROW_H - 1 );
            MgText( px + 8, y, px + 90, y + MG_ROW_H, lb, pid ? ( lhot ? COLOR_TEXT_DWHITE : RA_ARGB( 255, 130, 255, 130 ) ) : RA_ARGB( 255, 150, 150, 150 ), false );
        }
        else
            MgText( px + 8, y, px + 90, y + MG_ROW_H, c.Label, hot ? COLOR_TEXT_DWHITE : COLOR_TEXT_WHITE, false );
        MgFill( tl, cy - 2, tr, cy + 2, RA_ARGB( 255, 56, 46, 30 ) );
        const float t = MgToT( c, *c.Value );
        const int hx = tl + (int) ( t * ( tr - tl ) );
        MgFill( tl, cy - 2, hx, cy + 2, RA_ARGB( 255, 110, 160, 70 ) );
        MgFill( hx - 3, cy - 7, hx + 3, cy + 7, hot ? RA_ARGB( 255, 245, 235, 190 ) : RA_ARGB( 255, 215, 200, 140 ) );

        char buf[ 32 ];
        if( c.Decimals )
            sprintf( buf, "%.1f", (double) *c.Value );
        else
            sprintf( buf, "%d", (int) ( *c.Value + 0.5f ) );
        MgText( px + 180, y, px + W - 6, y + MG_ROW_H, buf, COLOR_TEXT_WHITE, true );
    }

    // counter / status
    {
        char buf[ 96 ];
        const int y = py + MgCounterY();
        if( MG.Active )
        {
            sprintf( buf, "Assets %d / %d%s", MG.Cur.placed, (int) MG.Limit, MG.Cur.capped ? " CAP" : "" );
            MgText( px + 8, y, px + W - 8, y + 20, buf, MG.Cur.capped ? RA_ARGB( 255, 255, 170, 60 ) : COLOR_TEXT_WHITE, false );
        }
        else
            MgText( px + 8, y, px + W - 8, y + 20, "Assets: -", RA_ARGB( 255, 150, 150, 150 ), false );
        MgText( px + 8, y + 20, px + W - 8, y + 38, MG.Status.c_str(), RA_ARGB( 255, 150, 150, 150 ), false );
    }

    // buttons
    {
        const int y = py + MgButtonsY();
        MgButton( px + 8, y, px + 112, y + 24, "Clear", true );
        MgButton( px + 124, y, px + 228, y + 24, MG.Blockers ? "Blockers ON" : "Blockers OFF", true );
        MgButton( px + 8, y + 28, px + 112, y + 52, "Apply", MG.Active );
        MgButton( px + 124, y + 28, px + 228, y + 52, "Cancel", MG.Active );
    }
}

// ---- map edits ----------------------------------------------------------------
// Same rebuild path the undo system uses after changing tiles / objects in the data.
static bool MgReload( FOMapper* m, ProtoMap* pmap )
{
    m->SelectClear();
    m->HexMngr.ClearSelTiles();
    m->InContObject = NULL;

    int sx = 0, sy = 0;
    m->HexMngr.GetScreenHexes( sx, sy );
    m->HexMngr.UnloadMap();
    if( !m->HexMngr.SetProtoMap( *pmap ) )
    {
        m->AddMess( "MapGen: map rebuild failed!" );
        return false;
    }
    m->HexMngr.FindSetCenter( sx, sy );
    m->HexMngr.RefreshMap();
    return true;
}

// New scenery object. live = also create the hex item now (otherwise SetProtoMap does it on reload).
static MapObject* MgCreate( FOMapper* m, ProtoMap* pmap, ushort pid, int x, int y, bool live )
{
    ProtoItem* proto = ItemMngr.GetProtoItem( pid );
    if( !proto )
    {
        if( !MG.WarnedProto )
            m->AddMessFormat( "MapGen: prototype %d not found, skipped.", (int) pid );
        MG.WarnedProto = true;
        return NULL;
    }

    MapObject* o = new MapObject();
    o->RunTime.FromMap = pmap;
    o->MapObjType = ( proto->IsScen() || proto->IsGrid() || proto->IsWall() || proto->Type == ITEM_TYPE_GENERIC ) ? MAP_OBJECT_SCENERY : MAP_OBJECT_ITEM;
    o->ProtoId = pid;
    o->MapX = (ushort) x;
    o->MapY = (ushort) y;
    o->Dir = proto->Dir;
    o->LightDistance = proto->LightDistance;
    o->LightIntensity = proto->LightIntensity;

    if( live )
    {
        o->RunTime.MapObjId = ++m->AnyId;
        if( !m->HexMngr.AddItem( m->AnyId, pid, (ushort) x, (ushort) y, 0, NULL ) )
        {
            o->Release();
            return NULL;
        }
    }
    else
        o->RunTime.MapObjId = 0;
    pmap->MObjects.push_back( o );
    return o;
}

// One pass over MObjects (DeleteMapObject would search the whole list for every object).
static void MgRemove( FOMapper* m, ProtoMap* pmap, const std::set< MapObject* >& rem, bool live )
{
    if( rem.empty() )
        return;
    std::vector< MapObject* >& v = pmap->MObjects;
    size_t                     out = 0;
    for( size_t i = 0; i < v.size(); i++ )
    {
        MapObject* o = v[ i ];
        if( rem.count( o ) )
        {
            if( live && o->RunTime.MapObjId )
            {
                ItemHex* item = m->HexMngr.GetItemById( o->RunTime.MapObjId );
                if( item )
                    m->HexMngr.FinishItem( item->GetId(), 0 );
            }
            o->Release();
        }
        else
            v[ out++ ] = o;
    }
    v.resize( out );
}

static void MgSetTiles( ProtoMap* pmap, const std::vector< MapGen::TileChange >& tc )
{
    for( size_t i = 0; i < tc.size(); i++ )
    {
        ProtoMap::TileVec& tv = pmap->GetTiles( tc[ i ].hx, tc[ i ].hy, false );
        tv.clear();
        if( tc[ i ].tile >= 0 && tc[ i ].tile < (int) MG.TileHash.size() )
        {
            tv.push_back( ProtoMap::Tile( MG.TileHash[ tc[ i ].tile ], tc[ i ].hx, tc[ i ].hy, 0, 0, DRAW_ORDER_TILE, false ) );
            tv.back().IsSelected = false;
        }
    }
}

// Forget generated objects that the user deleted or moved by hand since the last run.
static void MgValidate( ProtoMap* pmap, int w, int h )
{
    if( MG.At.size() != (size_t) w * h )
    {
        MG.At.assign( (size_t) w * h, NULL );
        MG.Cur = MapGen::Result();
        return;
    }
    std::vector< MapObject* > live( pmap->MObjects.begin(), pmap->MObjects.end() );
    std::sort( live.begin(), live.end() );
    for( size_t i = 0; i < MG.At.size(); i++ )
    {
        MapObject* o = MG.At[ i ];
        if( !o )
            continue;
        const bool ok = std::binary_search( live.begin(), live.end(), o ) && (int) o->MapX == (int) ( i % w ) && (int) o->MapY == (int) ( i / w );
        if( !ok )
        {
            MG.At[ i ] = NULL;
            if( i < MG.Cur.grid.size() )
                MG.Cur.grid[ i ] = 0;                           // let the next run put it back if still wanted
        }
    }
}

// hexes already used by the map (not counting our own preview objects)
static void MgBuildOccupied( ProtoMap* pmap, int w, int h, std::vector< char >& occ, bool& has_blockers )
{
    std::vector< MapObject* > gen;
    for( size_t i = 0; i < MG.At.size(); i++ )
        if( MG.At[ i ] )
            gen.push_back( MG.At[ i ] );
    std::sort( gen.begin(), gen.end() );

    occ.assign( (size_t) w * h, 0 );
    has_blockers = false;
    for( size_t i = 0; i < pmap->MObjects.size(); i++ )
    {
        MapObject* o = pmap->MObjects[ i ];
        if( std::binary_search( gen.begin(), gen.end(), o ) )
            continue;
        if( o->ContainerUID || (int) o->MapX >= w || (int) o->MapY >= h )
            continue;
        occ[ (size_t) o->MapY * w + o->MapX ] = 1;
        if( o->ProtoId == MapGen::Generator::BlockerProto() )
            has_blockers = true;
    }
}

static void MgStart( FOMapper* m, ProtoMap* pmap, int w, int h )
{
    // baseline for undo, taken BEFORE the first change
    UndoHistory* hist = UndoFind( pmap );
    if( !hist )
        UndoCreate( pmap );
    else if( UndoDirty )
        UndoCommit( m, pmap, hist );

    MG.Map = pmap;
    MG.TilesBackup = pmap->TilesField;
    MG.At.assign( (size_t) w * h, NULL );
    MG.Cur = MapGen::Result();
    MG.WarnedProto = false;
    MG.TileHash.resize( MapGen::Generator::TileCount() );
    for( int i = 0; i < MapGen::Generator::TileCount(); i++ )
        MG.TileHash[ i ] = Str::GetHash( MapGen::Generator::TileName( i ) );
    MG.Active = true;
    MapGenPreviewActive = true;
}

// Run the generator and bring the map in line with the result.
static void MgRegenerate( FOMapper* m )
{
    ProtoMap* pmap = m->CurProtoMap;
    const int w = pmap->Header.MaxHexX;
    const int h = pmap->Header.MaxHexY;

    if( !MG.Active )
        MgStart( m, pmap, w, h );
    MgValidate( pmap, w, h );

    std::vector< char > occ;
    bool                has_blockers = false;
    MgBuildOccupied( pmap, w, h, occ, has_blockers );

    MapGen::Params p = MG.P;
    p.maxObjects = (int) ( MG.Limit + 0.5f );
    p.scrollBlockers = MG.Blockers && !has_blockers;
    if( MG.Cleared )
        for( int i = 0; i < MapGen::CAT_COUNT; i++ )
            p.amount[ i ] = 0.0f;                       // sliders keep their values, only the result is empty
    MG.Gen.Generate( w, h, p, MG.Next, &occ );

    std::vector< MapGen::ObjChange >  oc;
    std::vector< MapGen::TileChange > tc;
    MapGen::DiffObjects( MG.Cur, MG.Next, oc );
    MapGen::DiffTiles( MG.Cur, MG.Next, tc );

    const bool tiles_changed = !tc.empty();
    const bool big = oc.size() > (size_t) MG_LIVE_LIMIT;
    const bool live = !tiles_changed && !big;       // otherwise: edit the data and rebuild the hex map once

    m->SelectClear();

    std::set< MapObject* > rem;
    for( size_t i = 0; i < oc.size(); i++ )
        if( !oc[ i ].add )
        {
            const size_t idx = (size_t) oc[ i ].y * w + oc[ i ].x;
            if( MG.At[ idx ] )
                rem.insert( MG.At[ idx ] );
            MG.At[ idx ] = NULL;
        }
    MgRemove( m, pmap, rem, live );

    for( size_t i = 0; i < oc.size(); i++ )
        if( oc[ i ].add )
            MG.At[ (size_t) oc[ i ].y * w + oc[ i ].x ] = MgCreate( m, pmap, oc[ i ].pid, oc[ i ].x, oc[ i ].y, live );

    if( tiles_changed )
        MgSetTiles( pmap, tc );

    if( tiles_changed || big )
        MgReload( m, pmap );
    else if( !oc.empty() )
        m->HexMngr.RefreshMap();

    MG.Cur = MG.Next;
    MG.Status = MG.Cleared ? "Cleared - seed or slider" : ( MG.Cur.capped ? "Cap hit: evenly thinned" : "Preview - Apply keeps it" );
}

static void MgApply( FOMapper* m )
{
    if( !MG.Active )
        return;
    const int n = MG.Cur.placed;
    MG.Active = false;
    MapGenPreviewActive = false;
    MG.Map = NULL;
    MG.At.clear();
    MG.TilesBackup.clear();
    MG.Cur = MapGen::Result();
    UndoMarkDirty();                                            // exactly one undo step for the whole result
    m->AddMessFormat( "MapGen: applied %d objects. Ctrl+Z undoes it.", n );
}

static void MgCancel( FOMapper* m )
{
    if( !MG.Active )
        return;
    if( MgMapOk( m ) && MG.Map == m->CurProtoMap )
    {
        ProtoMap* pmap = m->CurProtoMap;
        MgValidate( pmap, pmap->Header.MaxHexX, pmap->Header.MaxHexY );
        std::set< MapObject* > rem;
        for( size_t i = 0; i < MG.At.size(); i++ )
            if( MG.At[ i ] )
                rem.insert( MG.At[ i ] );
        m->SelectClear();
        MgRemove( m, pmap, rem, false );
        pmap->TilesField = MG.TilesBackup;
        MgReload( m, pmap );
    }
    MgReset();
    MG.Status = "Cancelled. Move a slider";
    m->AddMess( "MapGen: cancelled, map restored." );
}

static void MapGenToggle()
{
    FOMapper* m = FOMapper::Self;
    if( MG.Visible )
    {
        if( MG.Active )
            MgApply( m );                                       // closing the panel keeps the result
        MG.Visible = false;
        MG.Drag = -1;
        return;
    }
    if( !MgMapOk( m ) )
    {
        m->AddMess( "MapGen: create or load a map first." );
        return;
    }
    MG.Visible = true;
    MG.Cleared = false;
    MG.Status = "Generating...";
    MG.Pending = true;
}

// ---- per frame ------------------------------------------------------------------
static void MapGenProcess()
{
    FOMapper* m = FOMapper::Self;
    MapGenPlaceButton();

    // map unloaded / switched under a running preview: its objects belong to the old map now
    if( MG.Active && ( !MgMapOk( m ) || MG.Map != m->CurProtoMap ) )
    {
        MgReset();
        MG.Status = "Map changed - dropped";
        m->AddMess( "MapGen: map changed, preview was dropped (objects stay on that map)." );
    }

    if( !MG.Pending )
        return;
    if( !MG.Visible || !MgMapOk( m ) )
    {
        MG.Pending = false;
        return;
    }
    if( MG.Drag >= 0 && MgCtl[ MG.Drag ].TileStage )
        return;                                                 // wait for mouse release: tiles are re-solved once
    const uint now = Timer::FastTick();
    if( MG.Drag >= 0 && now - MG.LastRun < MG_THROTTLE_MS )
        return;

    MG.Pending = false;
    MG.LastRun = now;
    MgRegenerate( m );
}

// ---- input -----------------------------------------------------------------------
static void MgSetFromMouse( int i, int px )
{
    MgControl& c = MgCtl[ i ];
    int        tl, tr;
    MgTrack( px, tl, tr );
    const float v = MgFromT( c, (float) ( GameOpt.MouseX - tl ) / (float) ( tr - tl ) );
    if( v != *c.Value )
    {
        *c.Value = v;
        MG.Pending = true;
        if( MgIsAsset( c ) )
            MG.Cleared = false;
    }
}

// Clear: take the generated assets off the map right now. Slider values are NOT changed:
// changing the seed, Rnd, or moving an asset slider brings the assets back.
static void MgClearAssets()
{
    MG.Cleared = true;
    MG.Pending = true;
}

// Custom row: take the asset that is selected in the item tabs (scenery = generic items only).
// Shift + click clears the row.
static void MgSetCustom( FOMapper* m, int k )
{
    if( Keyb::ShiftDwn )
    {
        MG.P.customPid[ k ] = 0;
        MG.Pending = true;
        m->AddMessFormat( "MapGen: custom %d cleared.", k + 1 );
        return;
    }
    if( !m->IsObjectMode() || !( *m->CurItemProtos ).size() )
    {
        m->AddMess( "MapGen: select a scenery asset in the item tabs first." );
        return;
    }
    const ushort pid = ( *m->CurItemProtos )[ m->GetTabIndex() ].ProtoId;
    ProtoItem*   proto = ItemMngr.GetProtoItem( pid );
    if( !proto || proto->Type != ITEM_TYPE_GENERIC )
    {
        m->AddMess( "MapGen: only scenery (generic) items can be used." );
        return;
    }
    MG.P.customPid[ k ] = pid;
    MG.Cleared = false;
    if( MG.P.amount[ MapGen::CAT_CUSTOM1 + k ] <= 0.0f )
        MG.P.amount[ MapGen::CAT_CUSTOM1 + k ] = 1.0f;          // so it shows up right away
    MG.Pending = true;
    m->AddMessFormat( "MapGen: custom %d = prototype %d.", k + 1, (int) pid );
}

static void MgChangeSeed( int delta )
{
    MG.Cleared = false;
    MG.P.seed += delta;
    if( MG.P.seed < 0 )
        MG.P.seed = 0;
    MG.Pending = true;
}

// Left click. Returns true when the click was on the panel (nothing may be placed under it).
static bool MapGenMouseDown()
{
    FOMapper* m = FOMapper::Self;
    if( !m->IntVisible )
        return false;
    MapGenPlaceButton();
    if( MgIn( MapGenBtn[ 0 ], MapGenBtn[ 1 ], MapGenBtn[ 2 ], MapGenBtn[ 3 ] ) )
    {
        PlayButtonSound();
        MapGenToggle();
        return true;
    }
    if( !MG.Visible )
        return false;

    int px, py;
    MgGeom( px, py );
    if( !MgIn( px, py, px + MG_PANEL_W, py + MG_PANEL_H ) )
        return false;

    // seed row
    {
        const int y = py + MgSeedY();
        if( MgIn( px + 56, y + 2, px + 76, y + MG_ROW_H - 2 ) )
        {
            PlayButtonSound();
            MgChangeSeed( Keyb::ShiftDwn ? -100 : -1 );
            return true;
        }
        if( MgIn( px + 154, y + 2, px + 174, y + MG_ROW_H - 2 ) )
        {
            PlayButtonSound();
            MgChangeSeed( Keyb::ShiftDwn ? 100 : 1 );
            return true;
        }
        if( MgIn( px + 180, y + 2, px + 228, y + MG_ROW_H - 2 ) )
        {
            PlayButtonSound();
            MG.Cleared = false;
            MG.P.seed = (int) ( Timer::FastTick() % 99999 ) + 1;
            MG.Pending = true;
            return true;
        }
    }

    // sliders
    for( int i = 0; i < MG_NUM; i++ )
    {
        const int y = py + MgSliderY( i );
        int       tl, tr;
        MgTrack( px, tl, tr );
        if( MgCtl[ i ].Custom >= 0 && MgIn( px + 8, y, px + 90, y + MG_ROW_H - 1 ) )
        {
            PlayButtonSound();
            MgSetCustom( m, MgCtl[ i ].Custom );
            return true;
        }
        if( MgIn( tl - 6, y, tr + 6, y + MG_ROW_H - 1 ) )
        {
            MG.Drag = i;
            MgSetFromMouse( i, px );
            return true;
        }
    }

    // buttons
    {
        const int y = py + MgButtonsY();
        if( MgIn( px + 8, y, px + 112, y + 24 ) )
        {
            PlayButtonSound();
            MgClearAssets();
            return true;
        }
        if( MgIn( px + 124, y, px + 228, y + 24 ) )
        {
            PlayButtonSound();
            MG.Blockers = !MG.Blockers;
            MG.Pending = true;
            return true;
        }
        if( MG.Active && MgIn( px + 8, y + 28, px + 112, y + 52 ) )
        {
            PlayButtonSound();
            MgApply( m );
            MG.Visible = false;
            return true;
        }
        if( MG.Active && MgIn( px + 124, y + 28, px + 228, y + 52 ) )
        {
            PlayButtonSound();
            MgCancel( m );
            return true;
        }
    }
    return true;
}

static bool MapGenMouseMove()
{
    if( MG.Drag < 0 )
        return false;
    int px, py;
    MgGeom( px, py );
    MgSetFromMouse( MG.Drag, px );
    return true;
}

static void MapGenMouseUp()
{
    if( MG.Drag >= 0 )
    {
        MG.Drag = -1;
        if( MG.Active )
            MG.Pending = true;                                  // final run (also applies a tile-stage change)
    }
}

// Wheel over a slider row = one step (Shift = 5 steps). Wheel anywhere on the panel never zooms the map.
static bool MapGenWheel( int dy )
{
    FOMapper* m = FOMapper::Self;
    if( !m->IntVisible || !MG.Visible )
        return false;
    int px, py;
    MgGeom( px, py );
    if( !MgIn( px, py, px + MG_PANEL_W, py + MG_PANEL_H ) )
        return false;

    for( int i = 0; i < MG_NUM; i++ )
    {
        const int y = py + MgSliderY( i );
        if( MgIn( px, y, px + MG_PANEL_W, y + MG_ROW_H - 1 ) )
        {
            MgControl& c = MgCtl[ i ];
            float      st = c.Step;
            if( c.Power != 1.0f && *c.Value * 0.1f > st )
                st = *c.Value * 0.1f;
            if( Keyb::ShiftDwn )
                st *= 4.0f;
            float v = MgQuant( c, *c.Value + ( dy > 0 ? st : -st ) );
            if( v == *c.Value )                                 // always move at least one step
                v = MgQuant( c, *c.Value + ( dy > 0 ? c.Step : -c.Step ) );
            if( v != *c.Value )
            {
                *c.Value = v;
                MG.Pending = true;
                if( MgIsAsset( c ) )
                    MG.Cleared = false;
            }
            break;
        }
    }
    return true;
}
