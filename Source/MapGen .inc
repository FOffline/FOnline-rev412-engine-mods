// ============================================================================
// RNG / hashing  (SplitMix64: tiny, fast, identical on every platform)
// ============================================================================
static inline MgU64 Mix64( MgU64 z )
{
    z += 0x9E3779B97F4A7C15ULL;
    z = ( z ^ ( z >> 30 ) ) * 0xBF58476D1CE4E5B9ULL;
    z = ( z ^ ( z >> 27 ) ) * 0x94D049BB133111EBULL;
    return z ^ ( z >> 31 );
}

struct Rng
{
    MgU64 s;
    explicit Rng( MgU64 seed ): s( Mix64( seed ) ) {}
    MgU64  Next64() { s += 0x9E3779B97F4A7C15ULL; MgU64 z = s; z = ( z ^ ( z >> 30 ) ) * 0xBF58476D1CE4E5B9ULL; z = ( z ^ ( z >> 27 ) ) * 0x94D049BB133111EBULL; return z ^ ( z >> 31 ); }
    double Next() { return (double) ( Next64() >> 11 ) * ( 1.0 / 9007199254740992.0 ); }       // [0,1)
    double Uniform( double a, double b ) { return a + ( b - a ) * Next(); }
    double Normal() { double u1 = Next(); if( u1 < 1e-12 ) u1 = 1e-12; double u2 = Next(); return std::sqrt( -2.0 * std::log( u1 ) ) * std::cos( 2.0 * PI_ * u2 ); }
    int    Below( int n ) { return (int) ( Next() * n ); }
};

// Deterministic per-hex random in [0,1): pure function of (seed, x, y, salt)
static inline double HashCell( int seed, int x, int y, int salt )
{
    MgU64 h = Mix64( ( (MgU64) (unsigned) seed << 32 ) | (unsigned) salt );
    h = Mix64( h ^ ( ( (MgU64) (unsigned) y << 32 ) | (unsigned) x ) );
    return (double) ( h >> 11 ) * ( 1.0 / 9007199254740992.0 );
}

static inline int PopCount( MgU64 v )
{
    int c = 0;
    while( v ) { v &= v - 1; ++c; }
    return c;
}

static inline double Clamp01( double v ) { return v < 0.0 ? 0.0 : ( v > 1.0 ? 1.0 : v ); }
static inline double SmoothStep( double e0, double e1, double x )
{
    if( e1 <= e0 ) return x < e0 ? 0.0 : 1.0;
    double t = Clamp01( ( x - e0 ) / ( e1 - e0 ) );
    return t * t * ( 3.0 - 2.0 * t );
}

