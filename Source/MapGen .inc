{
    // text only
    MapGenPlaceButton();
    const bool hot = MgIn( MapGenBtn[ 0 ], MapGenBtn[ 1 ], MapGenBtn[ 2 ], MapGenBtn[ 3 ] );
    const uint col = MG.Visible ? RA_ARGB( 255, 130, 255, 130 ) : ( hot ? COLOR_TEXT_DWHITE : COLOR_TEXT_WHITE );
