// ---------------------------------------------------------------- generator API
// ============================================================================
// MapGen - portable desert map generator core (port of MapGen9000.py)
//
//  * No dependency on the Mapper / engine. Pure data in, pure data out.
//  * C++03 only (old MSVC / STLport friendly): no auto, no lambdas, no <random>.
//  * Deterministic on every platform: own RNG + per-hex hashing, same seed ->
//    same map. (It does NOT reproduce the numpy output of MapGen9000.py.)
//  * Any map size: width x height need not be equal (Mapper: MaxHexX x MaxHexY).
//
// Two stages with separate caches:
//   TILES   depends on  size, seed, tileMix            (heavy: constraint solver)
//   OBJECTS depends on  size, seed, tileMix + all other sliders (cheap)
// so moving an asset slider never re-solves the tiles.
//
// Object placement is a pure function of (seed, hex, category), so moving one
// slider changes only the hexes that crossed a threshold. DiffObjects() /
// DiffTiles() give the minimal add/remove list -> reactive live preview.
// ============================================================================


#if defined( _MSC_VER )
typedef unsigned __int64 MgU64;
#else
typedef unsigned long long MgU64;
#endif

namespace MapGen
{
// Order = collision priority when two categories want the same hex (first wins).
enum Category
{
    CAT_TREES = 0,
    CAT_DRY_TREES,
    CAT_ROCKS,
    CAT_CACTUSES,
    CAT_CORN,
    CAT_CUSTOM1,                   // user-chosen single scenery prototype (Params::customPid)
    CAT_CUSTOM2,
    CAT_CUSTOM3,
    CAT_MISC,
    CAT_GRASS,
    CAT_COUNT
};

struct Params
{
    int   seed;
    float tileMix;                 // 0..100   0 = all dark ground, 100 = all light ground
    float edgeBlend;               // 0..100   0 = hard-edged groups, 100 = soft gradient
    float amount[ CAT_COUNT ];     // 0..100   % of free playable hexes, indexed by Category
    int   maxObjects;              // hard cap on generated objects (scroll blockers not counted)
    unsigned short customPid[ 3 ]; // prototype of CAT_CUSTOM1..3, 0 = row unused
    bool  scrollBlockers;          // not a UI slider: false if the map already has its own blockers

    Params();                      // sensible defaults
};

struct Result
{
    int                           width, height;       // map size in hexes (as given)
    int                           tileCols, tileRows;  // tile grid: tile (cx,cy) sits at hex (cx*2, cy*2)
    std::vector< unsigned char >  tiles;               // tileCols*tileRows  tile table index, 255 = no tile
    std::vector< unsigned short > grid;                // width*height       proto id at hex (x + y*width), 0 = empty
    int                           counts[ CAT_COUNT ]; // placed objects per category (after cap)
    int                           blockers;            // scroll blockers in grid (not counted by the cap)
    int                           candidates;          // objects wanted before the cap was applied
    int                           placed;              // objects actually placed (<= maxObjects)
    bool                          capped;              // true if candidates > maxObjects
    bool                          tilesRecomputed;     // false when tile stage came from cache

    Result();
};

struct ObjChange
{
    unsigned short pid, x, y;
    bool           add;            // true = create, false = delete
};

struct TileChange
{
    unsigned short hx, hy;
    int            tile;           // index into tile table, -1 = remove
};

class Generator
{
public:
    Generator();

    // width x height = hex array size (Mapper: MaxHexX x MaxHexY).
    // occupied (optional): width*height, non-zero = hex already used by the map (building, wall...),
    //                      no generated object will be placed there.
    void Generate( int width, int height, const Params& p, Result& out, const std::vector< char >* occupied = 0 );

    // The playable area is an upright rectangle in screen space = [umin,umax] x [vmin,vmax] in skewed
    // hex space (u = y + x/2, v = y - 1.5x). It is the largest such rectangle that fits the hex array.
    static void PlayRect( int width, int height, double& umin, double& umax, double& vmin, double& vmax );
    static bool InsidePlayRect( int x, int y, double umin, double umax, double vmin, double vmax );

    // Tile table
    static int         TileCount();
    static const char* TileName( int index );     // "art\\tiles\\edg5000.frm"

    // Prototype lists
    static unsigned short        BlockerProto();
    static const unsigned short* Protos( int category, int& count );

private:
    // ---- caches ----
    int                           insW, insH;
    std::vector< char >           ins;            // w*h  inside playable shape
    std::vector< unsigned short > blockGrid;      // w*h  blocker proto or 0
    int                           blockCount;

    int                           groundW, groundH, groundSeed, groundMix;
    int                           gmw, gmh;       // blob grid size ((w+1)/2, (h+1)/2)
    std::vector< char >           blobs;          // gmw*gmh blob cells (valid when 0<mix<1000)
    bool                          groundInvert;   // false: blobs = dark patches; true: blobs = LIGHT islands (mix < 50)

    int                           tileW, tileH, tileSeed, tileMixKey;
    std::vector< unsigned char >  tileCache;

    int                           noiseW, noiseH, noiseSeed;
    std::vector< float >          noiseV;
    std::vector< float >          clump[ CAT_COUNT ];

    void EnsureShape( int w, int h );
    void EnsureGround( int w, int h, int seed, int mixKey );
    void EnsureTiles( int w, int h, int seed, int mixKey, Result& out );
    void EnsureNoise( int w, int h, int seed );
    bool PatchAtHex( int x, int y, int mixKey ) const;
};

// Minimal edit list to go from `before` to `after`. `before` may be a default (width==0) Result.
void DiffObjects( const Result& before, const Result& after, std::vector< ObjChange >& out );
void DiffTiles( const Result& before, const Result& after, std::vector< TileChange >& out );
}


